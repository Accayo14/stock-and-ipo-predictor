<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>IPO Dashboard — {{ generated.strftime('%d %b %Y') }}</title>
<style>
  :root{
    --bg:#f5f6f8; --surface:#fff; --surface-2:#eef1f5; --surface-3:#f8f9fb;
    --ink:#12161d; --ink-2:#48525f; --muted:#8a94a2; --line:#e0e5ec;
    --up:#0a7d4f; --up-bg:#e6f5ee; --down:#c22b3d; --down-bg:#fdebed;
    --warn:#96610a; --warn-bg:#fdf2e0; --accent:#1f5fbf; --accent-bg:#e9f0fc;
    --radius:14px;
    --sans:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  }
  @media (prefers-color-scheme:dark){
    :root{
      --bg:#0c0f14; --surface:#151a21; --surface-2:#1b212a; --surface-3:#11161c;
      --ink:#e9eef5; --ink-2:#aab4c2; --muted:#6c7787; --line:#242c37;
      --up:#3fb984; --up-bg:#0e2a20; --down:#f2687c; --down-bg:#2b1317;
      --warn:#e0a33a; --warn-bg:#2a2114; --accent:#5b9bf5; --accent-bg:#12233d;
    }
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);
       font-size:15px;line-height:1.55;-webkit-font-smoothing:antialiased}
  .wrap{max-width:1080px;margin:0 auto;padding:30px 18px 80px}
  h1{font-size:27px;letter-spacing:-.02em;margin:0 0 4px}
  .sub{color:var(--ink-2);font-size:14px;margin:0 0 22px}
  h2{font-size:12px;text-transform:uppercase;letter-spacing:.1em;
     color:var(--muted);margin:34px 0 12px;font-weight:650}

  /* summary chips */
  .chips{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:8px}
  .chip{background:var(--surface);border:1px solid var(--line);border-radius:999px;
        padding:6px 14px;font-size:13px;font-weight:600}
  .chip b{font-weight:750}
  .chip.apply{background:var(--up);color:#fff;border-color:var(--up)}
  .chip.consider{background:var(--warn-bg);color:var(--warn);border-color:var(--warn)}
  .chip.avoid{background:var(--down);color:#fff;border-color:var(--down)}

  .howto{background:var(--surface-3);border:1px solid var(--line);
         border-radius:var(--radius);padding:13px 17px;font-size:13.5px;
         color:var(--ink-2);margin-bottom:6px}
  .howto b{color:var(--ink)}

  /* card */
  .card{background:var(--surface);border:1px solid var(--line);
        border-radius:var(--radius);padding:20px 22px;margin-bottom:16px}
  .card.v-apply{border-left:4px solid var(--up)}
  .card.v-consider{border-left:4px solid var(--warn)}
  .card.v-avoid{border-left:4px solid var(--down)}
  .card.v-nodata{border-left:4px solid var(--muted);opacity:.9}
  .head{display:flex;justify-content:space-between;gap:16px;
        align-items:flex-start;flex-wrap:wrap}
  .name{font-size:19px;font-weight:700;letter-spacing:-.015em;margin:0}
  .tags{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-top:5px}
  .tag{font-size:11px;font-weight:650;letter-spacing:.03em;padding:2px 8px;
       border-radius:5px;background:var(--surface-2);color:var(--ink-2)}
  .tag.sme{background:var(--warn-bg);color:var(--warn)}
  .tag.urgent{background:var(--down);color:#fff}
  .tag.soon{background:var(--warn);color:#fff}
  .verdict{font-size:13px;font-weight:750;letter-spacing:.04em;padding:7px 15px;
           border-radius:9px;white-space:nowrap}
  .v-apply .verdict,.verdict.apply{background:var(--up);color:#fff}
  .verdict.consider{background:var(--warn-bg);color:var(--warn);
                    border:1px solid var(--warn)}
  .verdict.neutral{background:var(--surface-2);color:var(--ink-2)}
  .verdict.avoid{background:var(--down);color:#fff}
  .verdict.nodata,.verdict.notrated{background:var(--surface-2);
                                   color:var(--muted)}
  .chip.notrated,.chip.nodata{background:var(--surface-2);
                              color:var(--ink-2)}
  .score{font-size:12px;color:var(--muted);text-align:right;margin-top:5px;
         font-variant-numeric:tabular-nums}

  /* key strip */
  .strip{display:flex;gap:22px;flex-wrap:wrap;margin:15px 0 4px;padding:12px 0;
         border-top:1px solid var(--line);border-bottom:1px solid var(--line);
         font-size:13.5px;color:var(--ink-2);font-variant-numeric:tabular-nums}
  .strip b{color:var(--ink);font-weight:670}

  /* score breakdown */
  .axes{display:flex;flex-direction:column;gap:5px;margin:14px 0}
  .axis{display:flex;align-items:center;gap:10px;font-size:12.5px}
  .axis .lbl{width:92px;flex:0 0 92px;color:var(--ink-2)}
  .axis .track{flex:1;height:7px;background:var(--surface-2);border-radius:4px;
               position:relative;overflow:hidden}
  .axis .mid{position:absolute;left:50%;top:0;bottom:0;width:1px;
             background:var(--line)}
  .axis .fill{position:absolute;top:0;bottom:0;border-radius:4px}
  .axis .val{width:44px;text-align:right;font-variant-numeric:tabular-nums;
             color:var(--muted)}

  /* subscription */
  .subs{display:flex;flex-direction:column;gap:6px;margin:6px 0 2px}
  .subrow{display:flex;align-items:center;gap:10px;font-size:13px}
  .subrow .lbl{width:150px;flex:0 0 150px;color:var(--ink-2)}
  .subrow .track{flex:1;display:block;height:16px;background:var(--surface-2);
                 border-radius:5px;overflow:hidden}
  /* display:block matters: .fill is a <span>, and width/height are ignored on
     an inline box, which rendered every demand bar empty. */
  .subrow .fill{display:block;height:100%;border-radius:5px;background:var(--accent);min-width:2px}
  .subrow .fill.strong{background:var(--up)}
  .subrow .fill.weak{background:var(--down)}
  .subrow .val{width:62px;text-align:right;font-weight:670;
               font-variant-numeric:tabular-nums}

  /* gmp */
  .gmpbox{display:flex;gap:18px;align-items:center;flex-wrap:wrap;
          background:var(--surface-3);border:1px solid var(--line);
          border-radius:10px;padding:12px 15px;margin:12px 0}
  .gmpbox .big{font-size:22px;font-weight:720;font-variant-numeric:tabular-nums}
  .gmpspark{display:block}
  .gmpnote{font-size:12.5px;color:var(--muted);flex:1 1 240px}

  /* reasons */
  ul.reasons{list-style:none;padding:0;margin:8px 0 0}
  ul.reasons li{display:flex;gap:10px;padding:6px 0;font-size:14px;
                color:var(--ink-2);align-items:flex-start;
                border-bottom:1px solid var(--surface-2)}
  ul.reasons li:last-child{border-bottom:none}
  .ico{flex:0 0 auto;width:13px;font-size:11px;line-height:1.75}
  .i-bull{color:var(--up)} .i-bear{color:var(--down)} .i-neu{color:var(--muted)}
  .wt{flex:0 0 auto;font-size:11px;color:var(--muted);
      font-variant-numeric:tabular-nums;min-width:38px;text-align:right}

  /* data grid */
  .datagrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(258px,1fr));
            gap:12px;margin-top:10px}
  .dgroup{background:var(--surface-3);border:1px solid var(--line);
          border-radius:10px;padding:12px 14px}
  .dgroup h4{margin:0 0 8px;font-size:11px;text-transform:uppercase;
             letter-spacing:.08em;color:var(--muted);font-weight:650;
             display:flex;justify-content:space-between}
  .dgroup h4 span{font-weight:500;text-transform:none;letter-spacing:0}
  .dgroup dl{margin:0;display:grid;grid-template-columns:1fr auto;
             gap:3px 10px;font-size:12.5px}
  .dgroup dt{color:var(--ink-2)}
  .dgroup dd{margin:0;text-align:right;font-variant-numeric:tabular-nums;
             font-weight:600;color:var(--ink)}
  .dgroup dd.na{color:var(--muted);font-weight:400}

  details{margin-top:12px}
  summary{cursor:pointer;font-size:12.5px;color:var(--accent);font-weight:600;
          padding:5px 0;list-style:none}
  summary::-webkit-details-marker{display:none}
  summary::before{content:"▸ ";display:inline-block;transition:transform .15s}
  details[open] summary::before{content:"▾ "}

  .provisional{background:var(--warn-bg);border:1px solid var(--warn);
               border-radius:10px;padding:11px 14px;margin-top:14px;
               font-size:13px;color:var(--warn)}
  .gaps{font-size:12.5px;color:var(--muted);margin-top:11px;
        background:var(--surface-2);border-radius:8px;padding:9px 12px}

  /* research notes */
  .notes{background:var(--accent-bg);border:1px solid var(--accent);
         border-radius:10px;padding:14px 16px;margin-top:14px}
  .notes h3{margin:0 0 7px;font-size:12px;text-transform:uppercase;
            letter-spacing:.08em;color:var(--accent);font-weight:700}
  .notes .summary{font-size:14px;color:var(--ink);margin:0 0 9px}
  .notes ul{list-style:none;padding:0;margin:0}
  .notes li{display:flex;gap:9px;padding:4px 0;font-size:13.5px;
            color:var(--ink-2);align-items:flex-start}
  .notes .src{color:var(--muted);font-size:11.5px}
  .notes .adj{margin-top:9px;padding-top:9px;border-top:1px solid var(--accent);
              font-size:13px;color:var(--ink)}
  .stale{background:var(--warn-bg);border-color:var(--warn)}
  .stale h3{color:var(--warn)}
  .nonotes{font-size:12.5px;color:var(--muted);margin-top:12px;
           border:1px dashed var(--line);border-radius:8px;padding:9px 12px}
  footer{margin-top:40px;padding-top:18px;border-top:1px solid var(--line);
         color:var(--muted);font-size:12.5px}
  .empty{background:var(--surface);border:1px solid var(--line);
         border-radius:var(--radius);padding:26px;text-align:center;
         color:var(--muted)}

  /* ---------- overview list ---------- */
  .hint{color:var(--muted);font-size:13px;margin:22px 0 10px}
  ul.ipolist{list-style:none;padding:0;margin:0}
  ul.ipolist li{margin-bottom:10px}
  .row{display:flex;justify-content:space-between;align-items:center;gap:16px;
       flex-wrap:wrap;background:var(--surface);border:1px solid var(--line);
       border-radius:var(--radius);padding:15px 18px;text-decoration:none;
       color:inherit;transition:border-color .12s,transform .12s}
  .row:hover{border-color:var(--accent);transform:translateY(-1px)}
  .row.v-apply{border-left:4px solid var(--up)}
  .row.v-consider{border-left:4px solid var(--warn)}
  .row.v-avoid{border-left:4px solid var(--down)}
  .row.v-notrated,.row.v-nodata{border-left:4px solid var(--muted)}
  .col-name{display:flex;flex-direction:column;gap:7px;min-width:0;flex:1 1 320px}
  .col-name .nm{font-size:17px;font-weight:680;letter-spacing:-.01em}
  .tagrow{display:flex;gap:6px;flex-wrap:wrap}
  .col-verdict{display:flex;align-items:center;gap:14px}
  .col-verdict .more{font-size:12.5px;color:var(--accent);font-weight:600;
                     white-space:nowrap}

  /* ---------- detail view ---------- */
  .back{display:inline-block;font-size:13px;color:var(--accent);
        text-decoration:none;font-weight:600;margin-bottom:14px}
  .back:hover{text-decoration:underline}
  /* Without JS every section stays visible, so the page still works. */
  body.js .detail{display:none}
  body.js .detail.active{display:block}
  body.js.detail-open #overview{display:none}
</style>
</head>
<body>
<div class="wrap">

  <h1>IPO Dashboard</h1>
  <p class="sub">
    {{ generated.strftime('%A %d %B %Y, %H:%M') }} IST ·
    {{ open_count }} open for subscription · {{ upcoming_count }} upcoming
  </p>

  <div class="chips">
    {% for verdict, n in counts.items() %}
    <span class="chip {{ verdict|lower|replace(' ','') }}">{{ verdict }} <b>{{ n }}</b></span>
    {% endfor %}
  </div>

  <div class="howto">
    <b>How to read this.</b> Each verdict comes from five weighted axes —
    valuation, financials, demand, grey market and issue structure. Axes with
    no published data are dropped and lower the confidence figure rather than
    being guessed at. Grey market premium is deliberately capped: if removing
    it would drop an issue below the APPLY bar, the verdict is held at
    CONSIDER and says so. QIB demand before the final day is discounted,
    because institutional bids almost always land on the last day.
    <br><br>
    {% if notes_count and notes_age_days %}
    <b style="color:var(--warn)">News layer is {{ notes_age_days }} day{{ 's' if notes_age_days != 1 }}
    out of date — researched {{ notes_generated }}, not today.</b>
    Subscription multiples, grey market premium and days-remaining all move
    daily, so treat the blue panels below as background rather than as current
    fact, and re-run <code>/ipo</code> before acting on anything closing today.
    {% elif notes_count %}
    <b>News layer: {{ notes_count }} issue{{ 's' if notes_count != 1 }} researched
    {% if notes_generated %}({{ notes_generated }}){% endif %}.</b>
    The computed score cannot see news, regulatory action, anchor-book quality
    or sector conditions. Those are researched separately and shown in the blue
    panels — where they conflict with the computed verdict, the disagreement is
    stated rather than blended away.
    {% else %}
    <b>No news layer today.</b> These verdicts rest purely on published
    figures. Numbers cannot see a regulatory notice, a sector downturn or a
    weak anchor book — run <code>/ipo</code> in Claude Code to add that.
    {% endif %}
  </div>

  {% if not cards %}
  <div class="empty">No IPOs are open or upcoming right now.</div>
  {% endif %}

  <!-- ================= OVERVIEW: the landing view ================= -->
  <div id="overview">
    <p class="hint">Select an issue to see every figure behind its verdict.</p>
    <ul class="ipolist">
    {% for c in cards %}
    {% set a = c.a %}{% set d = a.data %}
      <li>
        <a class="row v-{{ a.verdict|lower|replace(' ','') }}"
           href="#{{ c.slug }}" data-slug="{{ c.slug }}">
          <span class="col-name">
            <span class="nm">{{ a.name }}</span>
            <span class="tagrow">
              <span class="tag {{ 'sme' if a.ipo_type == 'SME' else '' }}">{{ a.ipo_type }}</span>
              <span class="tag {{ 'urgent' if a.urgency == 'closes-today' else ('soon' if a.urgency == 'closes-tomorrow' else '') }}">
                {{ a.urgency_label }}</span>
              {% if d.min_investment %}
              <span class="tag">min {{ d.min_investment|rupees }}</span>
              {% endif %}
              {% if d.sub_total is not none %}
              <span class="tag">{{ '%.1fx'|format(d.sub_total) }} subscribed</span>
              {% endif %}
            </span>
          </span>
          <span class="col-verdict">
            <span class="verdict {{ a.verdict|lower|replace(' ','') }}">{{ a.verdict }}</span>
            <span class="more">Details &rarr;</span>
          </span>
        </a>
      </li>
    {% endfor %}
    </ul>
  </div>

  <!-- ================= DETAIL: one section per issue ================= -->
  {% for c in cards %}
  {% set a = c.a %}{% set d = a.data %}
  <section class="detail card v-{{ a.verdict|lower|replace(' ','') }}"
           id="{{ c.slug }}" data-detail>
    <a class="back" href="#">&larr; All IPOs</a>

    <div class="head">
      <div>
        <p class="name">{{ a.name }}</p>
        <div class="tags">
          <span class="tag {{ 'sme' if a.ipo_type == 'SME' else '' }}">{{ a.ipo_type }}</span>
          {% if d.sector %}<span class="tag">{{ d.sector }}</span>{% endif %}
          <span class="tag {{ 'urgent' if a.urgency == 'closes-today' else ('soon' if a.urgency == 'closes-tomorrow' else '') }}">
            {{ a.urgency_label }}</span>
        </div>
      </div>
      <div>
        <span class="verdict {{ a.verdict|lower|replace(' ','') }}">{{ a.verdict }}</span>
        <div class="score">score {{ '%+.2f'|format(a.score) }} ·
          confidence {{ '%.0f'|format(a.confidence * 100) }}%</div>
      </div>
    </div>

    <div class="strip">
      <span>Band <b>{{ d.price_band or '—' }}</b></span>
      <span>Lot <b>{{ d.lot_size or '—' }}</b></span>
      <span>Min <b>{{ d.min_investment|rupees }}</b></span>
      <span>Size <b>{{ a.issue_size or '—' }}</b></span>
      <span>Closes <b>{{ d.close_date or '—' }}</b></span>
      <span>Lists <b>{{ d.listing_date or '—' }}</b></span>
    </div>

    <!-- score breakdown -->
    <div class="axes">
      {% for ax in a.axis_rows %}
      <div class="axis">
        <span class="lbl">{{ ax.name }}</span>
        <span class="track"><span class="mid"></span>
          {% set w = (ax.score|abs) * 50 %}
          <span class="fill" style="
            {% if ax.score >= 0 %}left:50%;width:{{ w }}%;background:var(--up);
            {% else %}right:50%;width:{{ w }}%;background:var(--down);{% endif %}"></span>
        </span>
        <span class="val">{{ '%+.2f'|format(ax.score) }}</span>
      </div>
      {% endfor %}
    </div>

    {% if c.closing_day_provisional %}
    <div class="provisional">
      <b>Bidding is still open.</b> These subscription figures are provisional
      {% if c.sub_as_of %}(as of {{ c.sub_as_of.strftime('%H:%M') }}){% endif %}
      and will move sharply before the close. Institutional bids in particular
      land in the final hours &mdash; on 27 Aug 2026 one issue went from 0.66x
      to 181x institutional in a single afternoon. Re-run after the close
      before drawing any conclusion from the demand figures.
    </div>
    {% endif %}

    <!-- demand -->
    {% if d.sub_total is not none %}
    <h2 style="margin:16px 0 8px">Demand</h2>
    <div class="subs">
      {% for key, label, val in [
          ('qib','QIB (institutions)', d.sub_qib),
          ('nii','NII (wealthy individuals)', d.sub_nii),
          ('rii','Retail', d.sub_rii),
          ('total','Total', d.sub_total)] %}
      <div class="subrow">
        <span class="lbl">{{ label }}</span>
        <span class="track"><span class="fill {{ 'strong' if val and val >= 3 else ('weak' if val is not none and val < 1 else '') }}"
              style="width:{{ c.bars[key] }}%"></span></span>
        <span class="val">{{ '%.2fx'|format(val) if val is not none else '—' }}</span>
      </div>
      {% endfor %}
    </div>
    {% if d.retail_allotment_odds is not none %}
    <p style="font-size:12.5px;color:var(--muted);margin:8px 0 0">
      A one-lot retail application has roughly a
      <b style="color:var(--ink)">{{ '%.0f'|format(d.retail_allotment_odds * 100) }}%</b>
      chance of allotment{% if d.retail_allotment_odds < 1 %}, since retail is
      oversubscribed and allotment becomes a lottery{% endif %}.
    </p>
    {% endif %}
    {% endif %}

    <!-- grey market -->
    {% if d.gmp_pct is not none %}
    <div class="gmpbox">
      <div>
        <div class="big" style="color:{{ 'var(--up)' if d.gmp_pct > 0 else 'var(--muted)' }}">
          {{ '%+.1f'|format(d.gmp_pct) }}%</div>
        <div style="font-size:12px;color:var(--muted)">grey market premium</div>
      </div>
      {% if c.gmp_svg %}{{ c.gmp_svg|safe }}{% endif %}
      <div class="gmpnote">
        {% if d.estimated_listing %}Implies a listing near
          <b style="color:var(--ink)">{{ d.estimated_listing|rupees }}</b>.{% endif %}
        {% if d.gmp_trend %}
          Premium is <b style="color:var(--ink)">{{ d.gmp_trend.direction }}</b>
          ({{ '%+.1f'|format(d.gmp_trend.change_pp) }}pp over
          {{ d.gmp_trend.days }} day{{ 's' if d.gmp_trend.days != 1 }}).
        {% endif %}
        Unofficial and unregulated — treat as sentiment, not a forecast.
      </div>
    </div>
    {% endif %}

    <!-- every reason -->
    <h2 style="margin:18px 0 6px">Why — every reason behind this verdict</h2>
    <ul class="reasons">
      {% for e in a.evidence %}
      <li>
        <span class="ico {{ 'i-bull' if e.direction=='bullish' else ('i-bear' if e.direction=='bearish' else 'i-neu') }}">
          {{ '▲' if e.direction=='bullish' else ('▼' if e.direction=='bearish' else '•') }}</span>
        <span>{{ e.statement }}</span>
        <span class="wt">{{ '%+.2f'|format(e.score) }}</span>
      </li>
      {% endfor %}
      {% if not a.evidence %}
      <li><span class="ico i-neu">•</span><span>Nothing has been published for
        this issue yet — no price band, demand, premium or financials.</span></li>
      {% endif %}
    </ul>

    <!-- research layer: what the numbers cannot see -->
    {% if c.note %}
    <div class="notes {{ 'stale' if notes_age_days else '' }}">
      <h3>{% if notes_age_days %}Beyond the numbers — researched {{ notes_generated }},
        {{ notes_age_days }} day{{ 's' if notes_age_days != 1 }} old{% else %}
        Beyond the numbers — news &amp; context{% endif %}</h3>
      {% if c.note.summary %}<p class="summary">{{ c.note.summary }}</p>{% endif %}
      <ul>
        {% for item in c.note.get('items', []) %}
        <li>
          <span class="ico {{ 'i-bull' if item.direction=='bullish' else ('i-bear' if item.direction=='bearish' else 'i-neu') }}">
            {{ '▲' if item.direction=='bullish' else ('▼' if item.direction=='bearish' else '•') }}</span>
          <span>{{ item.text }}
            {% if item.source %}<span class="src">— {{ item.source }}</span>{% endif %}
          </span>
        </li>
        {% endfor %}
      </ul>
      {% if c.note.adjustment_reason %}
      <div class="adj"><b>On the computed verdict:</b> {{ c.note.adjustment_reason }}</div>
      {% endif %}
    </div>
    {% elif not d.is_upcoming %}
    <div class="nonotes">
      No news research recorded for this issue today. The verdict above rests
      on published figures alone — run <code>/ipo</code> in Claude Code to add
      the news and context layer.
    </div>
    {% endif %}

    <!-- everything we hold -->
    <details {% if a.urgency in ('closes-today','closes-tomorrow') %}open{% endif %}>
      <summary>All data on {{ a.name }}</summary>
      <div class="datagrid">
        {% for g in c.data_groups %}
        <div class="dgroup">
          <h4>{{ g.title }} <span>{{ g.known }}/{{ g.total }}</span></h4>
          <dl>
            {% for label, value in g.rows %}
            <dt>{{ label }}</dt>
            <dd class="{{ 'na' if value == '—' else '' }}">{{ value }}</dd>
            {% endfor %}
          </dl>
        </div>
        {% endfor %}
      </div>
      {% if d.detail_url %}
      <p style="font-size:12px;color:var(--muted);margin-top:10px">
        Source detail page: {{ d.detail_url }}</p>
      {% endif %}
    </details>

    {% if a.unavailable or d.missing %}
    <div class="gaps">
      <b>Not available:</b>
      {{ (a.unavailable + d.missing)|unique|sort|join('; ') }}.
      These were excluded from the score rather than estimated.
    </div>
    {% endif %}

  </section>
  {% endfor %}

  <footer>
    Issue lists and dates from BSE; lot size, demand, grey market premium and
    financials from InvestorGain. Generated locally — nothing about you was
    sent anywhere.
    <br><br>
    <strong>This is decision support, not financial advice.</strong> IPO
    pricing reflects what the seller wants, and a strong grey market premium
    has never been a guarantee of anything. Read the prospectus risk factors
    before applying — this tool cannot read them for you.
  </footer>
</div>

<script>
(function () {
  var body = document.body;
  body.classList.add('js');

  function slugs() {
    return Array.prototype.slice.call(document.querySelectorAll('[data-detail]'));
  }

  function render() {
    var hash = (location.hash || '').replace(/^#/, '');
    var target = hash ? document.getElementById(hash) : null;
    var found = target && target.hasAttribute('data-detail');

    slugs().forEach(function (el) {
      el.classList.toggle('active', found && el.id === hash);
    });
    body.classList.toggle('detail-open', !!found);
    // The browser performs its own jump to the anchor *after* this handler
    // runs, which left the reader halfway down a long detail card. Defer to
    // the next frame so our scroll is the one that sticks.
    requestAnimationFrame(function () { window.scrollTo(0, 0); });
  }

  window.addEventListener('hashchange', render);
  render();
})();
</script>
</body>
</html>
