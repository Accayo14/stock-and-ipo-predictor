# Copy this file to secrets.env and fill in only the channels you want.
# secrets.env is gitignored. Never commit real tokens.
#
# After filling this in, enable the channel in config.yaml under `delivery:`.

# ---------------------------------------------------------------------------
# Telegram  (easiest option - about two minutes to set up)
# ---------------------------------------------------------------------------
# 1. In Telegram, message @BotFather and send: /newbot
#    Follow the prompts; it replies with a token like 123456789:AAH...
# 2. Send any message to your new bot (it cannot message you until you do).
# 3. Open this URL in a browser, replacing <TOKEN>:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#    Find "chat":{"id":123456789 - that number is your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Email  (Gmail example)
# ---------------------------------------------------------------------------
# Gmail requires an App Password, not your normal password:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# Use port 587 (STARTTLS) or 465 (SSL).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# ---------------------------------------------------------------------------
# Optional: Tapetide MCP token (only if you enable it in config.yaml)
# Free token from https://tapetide.com/settings/tokens
# ---------------------------------------------------------------------------
TAPETIDE_TOKEN=
